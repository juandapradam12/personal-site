---
import Nav from './Nav.astro';
import { getSiteConfig } from '../../lib/content';

const site = getSiteConfig();
---

<header
  id="site-header"
  class="sticky top-0 z-40 border-b backdrop-blur"
  style="border-color: var(--color-border); background: color-mix(in srgb, var(--color-surface) 90%, transparent);"
>
  <div class="container-main flex flex-col gap-4 py-5 sm:flex-row sm:items-center sm:justify-between">
    <a href="/" class="no-underline" style="color: var(--color-text);">
      <span class="block text-lg font-semibold tracking-tight">{site.name}</span>
      <span class="mt-1.5 block text-sm tracking-wide" style="color: var(--color-muted);">
        {site.role}
      </span>
    </a>
    <Nav />
  </div>
</header>

<script>
  function setHeaderHeightVar() {
    const header = document.getElementById('site-header');
    if (header) {
      document.documentElement.style.setProperty('--header-height', `${header.offsetHeight}px`);
    }
  }
  setHeaderHeightVar();
  window.addEventListener('resize', setHeaderHeightVar);
</script>
