---
import SectionHeading from '../ui/SectionHeading.astro';
import { getCvConfig } from '../../lib/content';

const cv = getCvConfig();

const cardClass = 'space-y-1.5 rounded-lg border p-4 transition hover:opacity-95';
const cardStyle = 'border-color: var(--color-border); background: var(--color-surface);';
---

<SectionHeading title="Selected Projects" id="projects">
  <div class="grid gap-4 sm:grid-cols-2">
    {
      cv.projects.map((item) =>
        item.href ? (
          <a
            href={item.href}
            target="_blank"
            rel="noreferrer"
            class:list={[cardClass, 'block no-underline']}
            style={`${cardStyle} color: inherit;`}
          >
            <div class="flex items-start justify-between gap-2">
              <h3 class="text-sm font-semibold">{item.name}</h3>
              <span class="shrink-0 text-xs font-medium" style="color: var(--color-accent);">
                GitHub ↗
              </span>
            </div>
            <p class="text-xs font-medium" style="color: var(--color-accent);">
              {item.context}
            </p>
            <p class="text-sm" style="color: var(--color-muted);">
              {item.description}
            </p>
          </a>
        ) : (
          <article class={cardClass} style={cardStyle}>
            <h3 class="text-sm font-semibold">{item.name}</h3>
            <p class="text-xs font-medium" style="color: var(--color-accent);">
              {item.context}
            </p>
            <p class="text-sm" style="color: var(--color-muted);">
              {item.description}
            </p>
          </article>
        )
      )
    }
  </div>
</SectionHeading>
