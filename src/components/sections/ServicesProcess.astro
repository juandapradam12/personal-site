---
import SectionHeading from '../ui/SectionHeading.astro';
import { getServicesConfig } from '../../lib/content';

const services = getServicesConfig();
const hasProcess = services.process.length > 0;
---

{
  hasProcess && (
    <SectionHeading title="How I work" id="how-i-work">
      {services.processIntro && (
        <p class="mb-4 text-sm" style="color: var(--color-muted);">
          {services.processIntro}
        </p>
      )}
      <ol class="space-y-3">
        {services.process.map((step, index) => (
          <li class="flex items-start gap-3">
            <span
              class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-xs font-semibold"
              style="background: var(--color-accent-soft); color: var(--color-accent);"
            >
              {index + 1}
            </span>
            <div>
              <p class="text-sm font-semibold">{step.title}</p>
              {step.description && (
                <p class="text-sm" style="color: var(--color-muted);">
                  {step.description}
                </p>
              )}
            </div>
          </li>
        ))}
      </ol>
    </SectionHeading>
  )
}
