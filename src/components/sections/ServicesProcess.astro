---
import SectionHeading from '../ui/SectionHeading.astro';
import { getServicesConfig } from '../../lib/content';

const services = getServicesConfig();

const workflows =
  services.workflows && services.workflows.length > 0
    ? services.workflows
    : services.process && services.process.length > 0
      ? [
          {
            id: 'industry',
            label: 'Industry',
            title: 'End-to-end delivery',
            subtitle: services.processIntro,
            steps: services.process,
          },
        ]
      : [];

const principles = services.processPrinciples ?? [];
const hasWorkflows = workflows.length > 0;
---

{
  hasWorkflows && (
    <SectionHeading title="How I work" id="how-i-work">
      {services.processIntro && (
        <p class="mb-6 max-w-prose text-sm leading-relaxed" style="color: var(--color-muted);">
          {services.processIntro.trim()}
        </p>
      )}

      <div class:list={['grid gap-6', workflows.length > 1 && 'lg:grid-cols-2']}>
        {workflows.map((track) => (
          <article
            class="flex flex-col rounded-xl border border-l-4 p-5 sm:p-6"
            style="border-color: var(--color-border); border-left-color: var(--color-accent); background: var(--color-surface);"
            id={`how-i-work-${track.id}`}
          >
            <header class="mb-5 border-b pb-4" style="border-color: var(--color-border);">
              <p
                class="mb-1 text-xs font-semibold uppercase tracking-wider"
                style="color: var(--color-accent);"
              >
                {track.label || 'Workflow'}
              </p>
              <h3 class="text-lg font-semibold tracking-tight">{track.title}</h3>
              {track.subtitle && (
                <p class="mt-1 text-sm" style="color: var(--color-muted);">
                  {track.subtitle}
                </p>
              )}
              {track.outcome && (
                <p
                  class="mt-3 rounded-md px-3 py-2 text-sm leading-relaxed"
                  style="background: var(--color-accent-soft); color: var(--color-text);"
                >
                  {track.outcome}
                </p>
              )}
            </header>

            <ol class="flex-1 space-y-4">
              {track.steps.map((step, index) => (
                <li class="flex items-start gap-3">
                  <span
                    class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-xs font-semibold"
                    style="background: var(--color-accent); color: #ffffff;"
                  >
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <div class="min-w-0 pt-0.5">
                    <p class="text-sm font-semibold">{step.title}</p>
                    {step.description && (
                      <p class="mt-0.5 text-sm leading-relaxed" style="color: var(--color-muted);">
                        {step.description}
                      </p>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </article>
        ))}
      </div>

      {principles.length > 0 && (
        <div
          class="mt-6 rounded-xl border p-5 sm:p-6"
          style="border-color: var(--color-border); background: var(--color-accent-soft);"
        >
          <p
            class="mb-3 text-xs font-semibold uppercase tracking-wider"
            style="color: var(--color-accent);"
          >
            Across both workflows
          </p>
          <ul class="grid gap-2 sm:grid-cols-2">
            {principles.map((principle) => (
              <li class="flex items-start gap-2 text-sm" style="color: var(--color-text);">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full" style="background: var(--color-accent);" />
                {principle}
              </li>
            ))}
          </ul>
        </div>
      )}
    </SectionHeading>
  )
}
