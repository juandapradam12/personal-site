---
import SectionHeading from '../ui/SectionHeading.astro';
import TagList from '../ui/TagList.astro';
import { getAboutConfig } from '../../lib/content';

const about = getAboutConfig();
const hasBeyondWork = about.beyondWork.length > 0;
---

{
  hasBeyondWork && (
    <SectionHeading title="Beyond work" id="beyond-work">
      <TagList items={about.beyondWork} />
    </SectionHeading>
  )
}
