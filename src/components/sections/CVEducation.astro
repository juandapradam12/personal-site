---
import SectionHeading from '../ui/SectionHeading.astro';
import { getCvConfig } from '../../lib/content';

const cv = getCvConfig();
---

<SectionHeading title="Education" id="education">
  <div class="space-y-6">
    {
      cv.education.map((item) => (
        <article class="space-y-1">
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="text-base font-semibold">{item.degree}</h3>
            <p class="text-sm whitespace-nowrap" style="color: var(--color-muted);">
              {item.period}
            </p>
          </div>
          <p style="color: var(--color-muted);">{item.institution}</p>
          <p class="text-sm" style="color: var(--color-muted);">{item.details}</p>
        </article>
      ))
    }
  </div>
</SectionHeading>
