---
import SectionHeading from '../ui/SectionHeading.astro';
import { getCvConfig } from '../../lib/content';

const cv = getCvConfig();
---

<SectionHeading title="Certifications" id="certifications">
  <ul class="space-y-3">
    {
      cv.certifications.map((item) => (
        <li class="flex flex-col gap-0.5 text-sm sm:flex-row sm:items-baseline sm:justify-between">
          <span>
            <span class="font-medium">{item.name}</span>
            <span style="color: var(--color-muted);"> — {item.issuer}</span>
            {item.credentialId && (
              <span class="block text-xs sm:inline" style="color: var(--color-muted);">
                {' '}
                · Credential ID: {item.credentialId}
              </span>
            )}
          </span>
          <span class="whitespace-nowrap text-xs" style="color: var(--color-muted);">
            {item.date}
          </span>
        </li>
      ))
    }
  </ul>
</SectionHeading>
