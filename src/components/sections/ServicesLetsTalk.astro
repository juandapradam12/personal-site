---
import { getServicesConfig, getSiteConfig } from '../../lib/content';

const services = getServicesConfig();
const site = getSiteConfig();
const letsTalk = services.letsTalk;

const mailtoHref = letsTalk
  ? `mailto:${site.email}${
      letsTalk.emailSubject ? `?subject=${encodeURIComponent(letsTalk.emailSubject)}` : ''
    }`
  : undefined;
---

{
  letsTalk && (
    <section
      class="section-block flex flex-col items-start gap-4 rounded-xl border p-6 sm:flex-row sm:items-center sm:justify-between"
      id="lets-talk"
      style="border-color: var(--color-border); background: var(--color-accent-soft);"
    >
      <div class="space-y-1">
        <h2 class="text-xl font-semibold tracking-tight">{letsTalk.title}</h2>
        <p class="max-w-prose text-sm" style="color: var(--color-muted);">
          {letsTalk.description}
        </p>
      </div>
      <a
        href={mailtoHref}
        class="inline-flex shrink-0 items-center rounded-md px-4 py-2 text-sm font-semibold no-underline transition hover:opacity-90"
        style="background: var(--color-accent); color: var(--color-bg);"
      >
        {letsTalk.buttonLabel}
      </a>
    </section>
  )
}
