---
import { getServicesConfig, getSiteConfig } from '../../lib/content';

const services = getServicesConfig();
const site = getSiteConfig();
const letsTalk = services.letsTalk;

const mailtoHref = letsTalk
  ? `mailto:${site.email}${
      letsTalk.emailSubject ? `?subject=${encodeURIComponent(letsTalk.emailSubject)}` : ''
    }`
  : undefined;

const hasCalendly = Boolean(letsTalk?.calendlyUrl);
const hasForm = Boolean(letsTalk?.formAccessKey);

const cardClass = 'flex flex-col gap-3 rounded-lg border p-4';
const cardStyle = 'border-color: var(--color-border); background: var(--color-surface);';
const inputClass =
  'w-full rounded-md border px-3 py-2 text-sm outline-none transition focus:border-transparent focus:ring-2';
const inputStyle =
  'border-color: var(--color-border); background: var(--color-bg); color: var(--color-text);';
---

{
  letsTalk && (
    <section
      class="section-block space-y-5 rounded-xl border p-6"
      id="lets-talk"
      style="border-color: var(--color-border); background: var(--color-accent-soft);"
    >
      <div class="space-y-1">
        <h2 class="text-xl font-semibold tracking-tight">{letsTalk.title}</h2>
        <p class="max-w-prose text-sm" style="color: var(--color-muted);">
          {letsTalk.description}
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div class="space-y-4">
          <div class={cardClass} style={cardStyle}>
            <h3 class="text-sm font-semibold">Email</h3>
            <p class="text-sm" style="color: var(--color-muted);">
              Write to me directly, from any email provider.
            </p>
            <div class="flex flex-wrap items-center gap-2">
              <code class="rounded-md px-2 py-1 text-xs" style="background: var(--color-accent-soft);">
                {site.email}
              </code>
              <button
                type="button"
                id="copy-email-btn"
                data-email={site.email}
                class="rounded-md border px-2 py-1 text-xs font-medium transition hover:opacity-90"
                style={`border-color: var(--color-border); color: var(--color-text);`}
              >
                Copy
              </button>
            </div>
            <a
              href={mailtoHref}
              class="mt-auto inline-flex items-center justify-center rounded-md px-4 py-2 text-sm font-semibold no-underline transition hover:opacity-90"
              style="background: var(--color-accent); color: var(--color-bg);"
            >
              Send an email
            </a>
          </div>

          {hasCalendly && (
            <div class={cardClass} style={cardStyle}>
              <h3 class="text-sm font-semibold">Schedule a call</h3>
              <p class="text-sm" style="color: var(--color-muted);">
                Pick a time that works for you, directly on my calendar.
              </p>
              <a
                href={letsTalk.calendlyUrl}
                target="_blank"
                rel="noreferrer"
                class="mt-auto inline-flex items-center justify-center rounded-md px-4 py-2 text-sm font-semibold no-underline transition hover:opacity-90"
                style="background: var(--color-accent); color: var(--color-bg);"
              >
                {letsTalk.calendlyLabel || 'Book a call'}
              </a>
            </div>
          )}
        </div>

        {hasForm && (
          <form id="contact-form" class={`${cardClass} sm:row-span-2`} style={cardStyle}>
            <h3 class="text-sm font-semibold">Send a message</h3>
            <input type="hidden" name="access_key" value={letsTalk.formAccessKey} />
            <input type="hidden" name="subject" value={letsTalk.emailSubject || "New message from your site"} />
            <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

            <div class="space-y-1">
              <label for="contact-name" class="text-xs font-medium">
                Name
              </label>
              <input id="contact-name" name="name" type="text" required class={inputClass} style={inputStyle} />
            </div>
            <div class="space-y-1">
              <label for="contact-email" class="text-xs font-medium">
                Email
              </label>
              <input id="contact-email" name="email" type="email" required class={inputClass} style={inputStyle} />
            </div>
            <div class="space-y-1">
              <label for="contact-message" class="text-xs font-medium">
                Message
              </label>
              <textarea
                id="contact-message"
                name="message"
                rows="4"
                required
                class={inputClass}
                style={inputStyle}
              />
            </div>

            <button
              type="submit"
              class="inline-flex items-center justify-center rounded-md px-4 py-2 text-sm font-semibold transition hover:opacity-90"
              style="background: var(--color-accent); color: var(--color-bg);"
            >
              Send message
            </button>
            <p id="contact-form-status" class="text-sm" style="color: var(--color-muted);" />
          </form>
        )}
      </div>
    </section>
  )
}

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  copyBtn?.addEventListener('click', async () => {
    const email = copyBtn.getAttribute('data-email');
    if (!email) return;
    try {
      await navigator.clipboard.writeText(email);
      const original = copyBtn.textContent;
      copyBtn.textContent = 'Copied!';
      setTimeout(() => {
        copyBtn.textContent = original;
      }, 2000);
    } catch {
      // Clipboard API unavailable — the address is still visible to copy manually.
    }
  });

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-form-status');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status) return;

    const formData = new FormData(form);
    const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (submitButton) submitButton.disabled = true;
    status.textContent = 'Sending…';

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: formData,
      });
      const result = await response.json();
      status.textContent = result.message || (response.ok ? 'Thanks! I\u2019ll get back to you soon.' : 'Something went wrong.');
      if (response.ok) form.reset();
    } catch {
      status.textContent = 'Something went wrong. Please try emailing me directly.';
    } finally {
      if (submitButton) submitButton.disabled = false;
    }
  });
</script>
