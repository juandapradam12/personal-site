---
interface Props {
  role: string;
  company: string;
  location: string;
  period: string;
  highlights: string[];
}

const { role, company, location, period, highlights } = Astro.props;
---

<article class="space-y-2">
  <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
    <div>
      <h3 class="text-base font-semibold">{role}</h3>
      <p style="color: var(--color-muted);">
        {company} · {location}
      </p>
    </div>
    <p class="text-sm whitespace-nowrap" style="color: var(--color-muted);">{period}</p>
  </div>
  {
    highlights.length > 0 && (
      <ul class="list-disc space-y-1 pl-5 text-sm" style="color: var(--color-muted);">
        {highlights.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )
  }
</article>
