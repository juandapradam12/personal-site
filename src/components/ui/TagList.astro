---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<ul class="flex flex-wrap gap-2">
  {
    items.map((item) => (
      <li
        class="rounded-full px-3 py-1 text-sm"
        style="background: var(--color-accent-soft); color: var(--color-text);"
      >
        {item}
      </li>
    ))
  }
</ul>
