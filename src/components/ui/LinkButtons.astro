---
import type { CvLink } from '../../lib/content';

interface Props {
  links: CvLink[];
  noPrintLabels?: string[];
}

const { links, noPrintLabels = [] } = Astro.props;
---

{
  links.length > 0 && (
    <div class="flex flex-wrap gap-3 pt-1">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'inline-flex items-center rounded-md border px-3 py-1.5 text-sm font-medium no-underline transition hover:opacity-90',
            { 'no-print': noPrintLabels.includes(link.label) },
          ]}
          style="border-color: var(--color-border); background: var(--color-surface); color: var(--color-text);"
          target={link.href.startsWith('http') ? '_blank' : undefined}
          rel={link.href.startsWith('http') ? 'noreferrer' : undefined}
        >
          {link.label}
        </a>
      ))}
    </div>
  )
}
