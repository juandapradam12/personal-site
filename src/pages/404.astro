---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteConfig } from '../lib/content';

const site = getSiteConfig();

const links = [
  { label: 'About', href: '/' },
  { label: 'CV', href: '/cv' },
  { label: 'Work', href: '/work' },
  { label: 'Research', href: '/research' },
  { label: 'Services', href: '/services' },
];
---

<BaseLayout
  title={`Page not found — ${site.name}`}
  description="The page you are looking for does not exist."
  noindex
>
  <section class="flex flex-col items-start gap-6 py-10 sm:py-16">
    <p
      class="text-xs font-semibold uppercase tracking-wider"
      style="color: var(--color-accent);"
    >
      Error 404
    </p>
    <div class="space-y-3">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Page not found</h1>
      <p class="max-w-prose text-base leading-relaxed" style="color: var(--color-muted);">
        That link does not match any page on this site. It may have moved, or the URL
        might have a typo.
      </p>
    </div>

    <div class="flex flex-wrap gap-3">
      <a
        href="/"
        class="inline-flex items-center rounded-md px-4 py-2 text-sm font-semibold no-underline transition hover:opacity-90"
        style="background: var(--color-accent); color: #ffffff;"
      >
        Back to home
      </a>
      {
        links.slice(1).map((link) => (
          <a
            href={link.href}
            class="inline-flex items-center rounded-md border px-4 py-2 text-sm font-medium no-underline transition hover:opacity-90"
            style="border-color: var(--color-border); background: var(--color-surface); color: var(--color-text);"
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
