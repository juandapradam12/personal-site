---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import LinkButtons from '../components/ui/LinkButtons.astro';
import AboutStory from '../components/sections/AboutStory.astro';
import AboutBeyondWork from '../components/sections/AboutBeyondWork.astro';
import { getSiteConfig, getCvConfig, getAboutConfig } from '../lib/content';

const site = getSiteConfig();
const cv = getCvConfig();
const about = getAboutConfig();
const contactLinks = cv.links.filter((link) => link.label !== 'Download PDF');
---

<BaseLayout
  title={site.seo.title}
  description={about.intro.trim()}
>
  <div class="flex flex-col-reverse gap-6 sm:flex-row sm:items-start sm:justify-between">
    <div class="flex-1" data-reveal style="--reveal-delay: 40ms;">
      <PageHeader title={site.name} description={about.intro.trim()} />
      <p class="mt-2 text-sm tracking-wide" style="color: var(--color-muted);">
        {site.role}
      </p>
    </div>
    <div
      class="flex shrink-0 flex-col items-center gap-3"
      data-reveal
      style="--reveal-delay: 120ms;"
    >
      <img
        src="/images/juan.jpg"
        alt="Juan David Prada Malagón"
        width="399"
        height="500"
        class="h-40 w-32 rounded-2xl border object-cover sm:h-48 sm:w-40"
        style="border-color: var(--color-border);"
      />
      <LinkButtons links={contactLinks} />
    </div>
  </div>
  <AboutStory />
  <AboutBeyondWork />

  <script is:inline>
    (() => {
      const show = (el) => el.classList.add('is-visible');

      const run = () => {
        const els = [...document.querySelectorAll('[data-reveal]')];
        if (!els.length) return;

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          els.forEach(show);
          return;
        }

        // Hide first, then reveal so the entrance is always visible on load.
        document.documentElement.classList.add('js');

        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            els.forEach(show);

            // Keep observing any late/below-fold nodes if content grows later.
            const observer = new IntersectionObserver(
              (entries) => {
                for (const entry of entries) {
                  if (!entry.isIntersecting) continue;
                  show(entry.target);
                  observer.unobserve(entry.target);
                }
              },
              { rootMargin: '0px 0px -6% 0px', threshold: 0.08 },
            );

            els.forEach((el) => {
              if (!el.classList.contains('is-visible')) observer.observe(el);
            });
          });
        });
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', run);
      } else {
        run();
      }
    })();
  </script>
</BaseLayout>
